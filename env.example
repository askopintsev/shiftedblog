# =============================================================================
# Required — Django core
# =============================================================================
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
# Or run: ./scripts/setup.sh
SECRET_KEY=your-secret-key-here-change-this-in-production
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,localhost,127.0.0.1
# Absolute public site URL (required in production; used for sitemaps + editor-ui build)
SITE_URL=https://yourdomain.com

# =============================================================================
# Required — PostgreSQL
# =============================================================================
DB_NAME=shiftedblog
DB_USER=shiftedblog
DB_PASS=your-strong-database-password-here
DB_HOST=db
DB_PORT=5432
# Must match DB_* when using Docker Compose Postgres
POSTGRES_DB=shiftedblog
POSTGRES_USER=shiftedblog
POSTGRES_PASSWORD=your-strong-database-password-here

# =============================================================================
# Infrastructure
# =============================================================================
REDIS_URL=redis://redis:6379/1
# Production secrets file name is secrets.env (not .env) — Compose interpolates $ in .env
# SHIFTED_BLOG_LOG_DIR=/tmp/shiftedblog_logs
# HOST_UID=1000
# HOST_GID=1000
BACKUP_DIR="/backups"
# YADISK_TOKEN=

# Nginx generation (./scripts/generate-nginx-conf.sh / setup production)
# DOMAIN=yourdomain.com
# EDITOR_DOMAIN=editor.yourdomain.com
# SSL_CERT_NAME=yourdomain.com
# EXTRA_DOMAINS=yourdomain.online,www.yourdomain.online
# Legacy hosts: HTTPS 301 to SITE_URL / EDITOR_DOMAIN (not EXTRA_DOMAINS)
# REDIRECT_FROM_DOMAINS=olddomain.com,www.olddomain.com
# REDIRECT_FROM_EDITOR_DOMAINS=editor.olddomain.com
# SERVER_IP=
# Later domain change without rotating keys: ./scripts/apply-domain.sh
# Host/domain move playbook: docs/en/host-migration.md

# =============================================================================
# Security / cookies / SSL
# =============================================================================
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_AGE=3600
SESSION_EXPIRE_AT_BROWSER_CLOSE=False
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
CSRF_COOKIE_SECURE=True
CSRF_COOKIE_HTTPONLY=False
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
SECURE_REFERRER_POLICY=strict-origin-when-cross-origin
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True
AXES_ENABLED=True
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_TIME=1
AXES_RESET_ON_SUCCESS=True
AXES_VERBOSE=True
AXES_LOGIN_FAILURE_LIMIT=5
AXES_IPWARE_PROXY_COUNT=1
AXES_IPWARE_PROXY_ORDER=left-most
RATELIMIT_ENABLE=True
# Generate: ./scripts/security/generate-admin-url.sh
ADMIN_URL=mellon

# =============================================================================
# Email — password stays in env; host/from/admin may also be set in Site settings
# =============================================================================
# Bootstrap defaults (override non-secrets later in admin → Site settings)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com

# =============================================================================
# Site settings bootstrap (optional — prefer admin → Core → Site settings)
# =============================================================================
# TWITTER_SITE=@your_x_handle
# TELEGRAM_USE_RICH_MESSAGES=false
# TEXT_QUALITY_PY_CHECKER_ENABLED=False
# TEXT_QUALITY_LANGUAGETOOL_LANGUAGE=ru-RU

# =============================================================================
# Secrets rotation reminders (optional ISO dates YYYY-MM-DD)
# =============================================================================
# SECRET_KEY_ROTATED_AT=2026-01-15
# CREDENTIALS_ENCRYPTION_KEY_ROTATED_AT=2026-01-15
SECRETS_ROTATION_MAX_AGE_DAYS=90

# =============================================================================
# Optional integrations
# =============================================================================
DZEN_VERIFICATION_FILE=
# Fernet key for core.Credential encryption:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHANNEL_NAME=mychannel
# TELEGRAM_CHAT_ID=
# TELEGRAM_CHANNEL_HAS_SUBSCRIPTION=false
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_OPERATOR_SESSION=
# HTTP_PROXY=
# HTTPS_PROXY=
# TELEGRAM_HTTP_PROXY=

# =============================================================================
# Editor SPA (subdomain) + Vite build-time
# =============================================================================
# EDITOR_URL=https://editor.yourdomain.com
# CORS_ALLOWED_ORIGINS=https://editor.yourdomain.com
# VITE_API_BASE=/api/editor/v1
# VITE_PUBLIC_SITE_BASE=https://yourdomain.com
# SESSION_COOKIE_DOMAIN=.yourdomain.com
# CSRF_COOKIE_DOMAIN=.yourdomain.com
# SESSION_COOKIE_SAMESITE=None
# CSRF_COOKIE_SAMESITE=None

# =============================================================================
# Other
# =============================================================================
PREPEND_WWW=False
