#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if ! command -v uv >/dev/null 2>&1; then
  echo "pre-commit: uv is required. Install it from https://docs.astral.sh/uv/"
  exit 1
fi

PATHS=(api blog core editor sender shiftedblog team manage.py templates)

if git diff --cached --name-only | grep -qE '^(pyproject\.toml|uv\.lock)$'; then
  echo "pre-commit: requirements.txt export check"
  uv export --no-dev -o requirements.txt.check
  tail -n +3 requirements.txt > requirements.body
  tail -n +3 requirements.txt.check > requirements.check.body
  if ! diff -q requirements.body requirements.check.body >/dev/null 2>&1; then
    rm -f requirements.txt.check requirements.body requirements.check.body
    echo "pre-commit: requirements.txt is out of date. Run: ./scripts/export-requirements.sh"
    exit 1
  fi
  rm -f requirements.txt.check requirements.body requirements.check.body
fi

echo "pre-commit: ruff format check"
uv run --extra dev --python 3.14 ruff format --check "${PATHS[@]}"

echo "pre-commit: ruff lint"
uv run --extra dev --python 3.14 ruff check --ignore RUF001 "${PATHS[@]}"

echo "pre-commit: pyright"
uv run --extra dev --python 3.14 pyright "${PATHS[@]}"

echo "pre-commit: bandit"
uv run --extra dev --python 3.14 bandit -c pyproject.toml -r blog core editor sender shiftedblog team -ll -x '**/migrations/*'
